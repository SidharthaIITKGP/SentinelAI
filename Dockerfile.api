FROM python:3.11-slim

WORKDIR /app

# Install system deps for spacy/presidio
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download the stronger embedding model during build
# all-mpnet-base-v2: 420MB, 768-dim, much stronger than all-MiniLM-L6-v2
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-mpnet-base-v2')"

COPY . .

# Download spacy model (must match NLP_MODEL in engines/responsibility/pii_check/pii_detector.py)
RUN python -m spacy download en_core_web_sm

EXPOSE 8000

CMD ["uvicorn", "core.main:app", "--host", "0.0.0.0", "--port", "8000"]

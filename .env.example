# External services
GROQ_API_KEY=
DATABASE_URL=postgresql://sentinelai:sentinelai@localhost:5432/sentinelai
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Lightweight demo authentication (replace all sample values before deployment)
SENTINEL_AUTH_ENABLED=true
SENTINEL_TENANT_API_KEYS_JSON={"replace-with-tenant-key":"acme_corp"}
SENTINEL_REVIEWER_API_KEYS_JSON={"replace-with-reviewer-key":{"reviewer_id":"reviewer_demo","allowed_tenants":["acme_corp"]}}

# Audit content: redacted (default), metadata_only, or explicit raw opt-in
SENTINEL_AUDIT_CONTENT_MODE=redacted

# Explicit browser origins; comma-separated, never wildcarded with credentials
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Dashboard build-time configuration. Never place a reviewer key in the bundle.
VITE_API_URL=http://localhost:8000
VITE_SENTINEL_API_KEY=replace-with-tenant-key
